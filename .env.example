# Salin ke .env. Docker Compose membaca file ini; `go run` lokal juga.
# Nilai di bawah aman untuk pengembangan saja. Ganti semua rahasia untuk server sungguhan.

APP_NAME=teralur
APP_ENV=localhost
IS_LOGGER=true
GOLANG_PORT=8888
NGINX_PORT=81

# Postgres. Saat `go run` lokal, aplikasi terhubung ke container lewat localhost:5434.
DB_HOST=localhost
DB_PORT=5434
DB_USER=teralur
DB_PASS=teralur
DB_NAME=teralur

# Wajib, minimal 16 karakter (aplikasi menolak start tanpa ini). Buat baru: openssl rand -hex 32
JWT_SECRET=dev-ganti-dengan-rahasia-panjang

# Akun admin awal (dibuat sekali saat seeder jalan, tidak ditimpa sesudahnya)
ADMIN_EMAIL=admin@teralur.test
ADMIN_PASSWORD=admin12345
# true = isi sekolah, pendidik, dan akun contoh. Matikan di server sungguhan.
SEED_DEMO=true

# Dokumentasi Scalar di /docs mati saat APP_ENV=production, kecuali ini true
DOCS_ENABLED=false

# false = matikan notifikasi "tenggat terlewat" yang dikirim tiap pagi pukul 08.00 WIB
PENGINGAT_TENGGAT=true

# Garage (object storage). Saat `go run` lokal, S3 API container ada di localhost:3900.
S3_ENDPOINT=localhost:3900
S3_REGION=garage
S3_USE_SSL=false
S3_BUCKET=teralur
# Key ID: "GK" + 24 hex; secret: 64 hex. Buat baru: echo GK$(openssl rand -hex 12); openssl rand -hex 32
S3_ACCESS_KEY=GK0123456789abcdef01234567
S3_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Buat baru: openssl rand -hex 32
GARAGE_RPC_SECRET=1f0b6c3a9d8e7f6a5b4c3d2e1f0a9b8c7d6e5f4a3b2c1d0e9f8a7b6c5d4e3f2a
GARAGE_ADMIN_TOKEN=dev-garage-admin-token
